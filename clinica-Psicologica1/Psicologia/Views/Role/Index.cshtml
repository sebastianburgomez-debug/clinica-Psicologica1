@model IEnumerable<Psicologia.Data.Entities.Specialty>

<div class="container mt-4">
    <h2>Gestión de Especialidades</h2>

    <form asp-action="Create" method="post" class="row g-3 my-3">
        <div class="col-auto">
            <input type="text" name="name" class="form-control" placeholder="Nombre de especialidad" required />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Agregar</button>
        </div>
    </form>

    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Especialidad</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.SpecialtyId</td>
                    <td>@item.Name</td>
                    <td>
                        <a asp-action="Delete" asp-route-id="@item.SpecialtyId" class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>