@model IEnumerable<Specialty>
@{
    ViewData["Title"] = "Especialidades";
}

<h2 class="mb-4 text-primary">Gestión de Especialidades</h2>

<form asp-controller="Specialty" asp-action="Create" method="post" class="row g-3 mb-4">
    <div class="col-md-6">
        <input type="text" name="name" class="form-control" placeholder="Nombre de especialidad" maxlength="100" required />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-success w-100">Agregar</button>
    </div>
</form>

<table class="table table-hover table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th style="width: 10%;">ID</th>
            <th>Especialidad</th>
            <th style="width: 20%;" class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SpecialtyId</td>
                <td>@item.Name</td>
                <td class="text-center">
                    <form asp-controller="Specialty" asp-action="Delete" asp-route-id="@item.SpecialtyId" method="post"
                          onsubmit="return confirm('¿Eliminar esta especialidad?');">
                        <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
