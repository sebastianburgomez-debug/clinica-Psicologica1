@model CreateClinicalServiceDTO
@using System.Globalization

@{
    ViewData["Title"] = "Nuevo Servicio";
}

<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Servicios</a></li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">

    <div class="card">

        <div class="card-header">

            <div class="row">

                <h3 class="m-0 font-weight-bold text-primary col-md-11">@ViewData["Title"]</h3>

            </div>

        </div>

        <div class="card-body">

            <form asp-action="Create" method="POST" class="row g-3 mt-2">

                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="Name" class="form-control" placeholder="@Html.DisplayNameFor(dto => dto.Name)" />
                        <label asp-for="Name"></label>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <select asp-for="SpecialtyId" asp-items="Model.Specialties" class="form-select">
                            <option value="">-- General (todas las especialidades) --</option>
                        </select>
                        <label asp-for="SpecialtyId"></label>
                        <span asp-validation-for="SpecialtyId" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="DurationMinutes" type="number" min="15" max="240" step="5" class="form-control" placeholder="@Html.DisplayNameFor(dto => dto.DurationMinutes)" />
                        <label asp-for="DurationMinutes"></label>
                        <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        @* Valor sin decimales y en formato invariante para que el input numérico lo acepte en cualquier cultura *@
                        <input asp-for="ReferenceRate" type="number" min="0" step="1" class="form-control"
                               value="@Model.ReferenceRate.ToString("0", CultureInfo.InvariantCulture)"
                               placeholder="@Html.DisplayNameFor(dto => dto.ReferenceRate)" />
                        <label asp-for="ReferenceRate"></label>
                        <span asp-validation-for="ReferenceRate" class="text-danger"></span>
                    </div>
                    <small class="text-muted"><i class="bi bi-info-circle"></i> Valor de referencia meramente informativo (no se usa para facturar).</small>
                </div>

                <div class="col-md-12">
                    <div class="form-floating">
                        <textarea asp-for="Description" class="form-control" style="height: 100px" placeholder="@Html.DisplayNameFor(dto => dto.Description)"></textarea>
                        <label asp-for="Description"></label>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>

                <div class="text-center mt-3">
                    <button class="btn btn-primary" type="submit">Guardar</button>
                    <a asp-action="Index" class="btn btn-secondary">Volver</a>
                </div>

            </form>

        </div>
    </div>

</section>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
