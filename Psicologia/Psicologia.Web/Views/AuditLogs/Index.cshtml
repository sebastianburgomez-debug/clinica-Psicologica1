@model PaginationResponse<AuditLogDTO>

@{
    ViewData["Title"] = "Auditoría";
}

<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item">Administración del Sistema</li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">

    <div class="card">

        <div class="card-header">

            <div class="row">

                <h3 class="m-0 font-weight-bold text-primary col-md-12">Auditoría de accesos y cambios</h3>

            </div>

        </div>

        <div class="card-body mt-3">

            <form asp-action="Index" class="navbar-search" method="GET">

                <input type="hidden" name="Page" value="1" />

                <div class="row mt-3">

                    <div class="col-md-auto">
                        <select asp-for="RecordsPerPage" class="form-select bg-light border-0 small">
                            <option value="5" selected="@(Model.RecordsPerPage == 5)">5</option>
                            <option value="10" selected="@(Model.RecordsPerPage == 10)">10</option>
                            <option value="15" selected="@(Model.RecordsPerPage == 15)">15</option>
                            <option value="30" selected="@(Model.RecordsPerPage == 30)">30</option>
                            <option value="50" selected="@(Model.RecordsPerPage == 50)">50</option>
                        </select>
                    </div>

                    <div class="col-md-10">
                        <div class="input-group mb-3">
                            <input type="text"
                                   class="form-control bg-light border-0 small"
                                   placeholder="Buscar por usuario, acción, módulo o descripción..."
                                   aria-label="search"
                                   asp-for="Filter" />

                            <button class="btn btn-primary"><i class="bi bi-search"></i></button>
                        </div>
                    </div>

                </div>

            </form>

            <table class="table table-bordered table-sm align-middle">

                <thead>
                    <tr>
                        <th style="width: 150px;">Fecha</th>
                        <th>Usuario</th>
                        <th>Acción</th>
                        <th>Módulo</th>
                        <th>Descripción</th>
                        <th>IP</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.List.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">No hay registros para mostrar.</td>
                        </tr>
                    }

                    @foreach (AuditLogDTO item in Model.List)
                    {
                        string actionClass = item.Action switch
                        {
                            AuditActions.LOGIN => "bg-success",
                            AuditActions.LOGIN_FAILED => "bg-danger",
                            AuditActions.LOGOUT => "bg-secondary",
                            AuditActions.DELETE => "bg-danger",
                            AuditActions.DEACTIVATE => "bg-warning text-dark",
                            AuditActions.REJECT => "bg-warning text-dark",
                            _ => "bg-primary"
                        };

                        <tr>
                            <td><small>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</small></td>
                            <td>@item.UserName</td>
                            <td><span class="badge @actionClass">@item.Action</span></td>
                            <td>@item.Entity</td>
                            <td>@item.Description</td>
                            <td><small class="text-muted">@item.IpAddress</small></td>
                        </tr>
                    }
                </tbody>

            </table>

            @await Html.PartialAsync("_PaginationComponent", Model)

        </div>
    </div>

</section>
