@model PaginationResponse<AppointmentDTO>
@using Psicologia.Web.Data.Entities
@inject IAccountService _accountService

@{
    ViewData["Title"] = "Citas";

    bool canUpdate = await _accountService.AccountUserIsAuthorizedAsync("appointments.update");
    User? accountUser = await _accountService.GetAccountUserAsync();
    bool isPatient = accountUser?.Role?.Name == Env.PATIENT_ROLE_NAME;
}

<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item">Atención Clínica</li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">

    <div class="card">

        <div class="card-header">

            <div class="row">

                <h3 class="m-0 font-weight-bold text-primary col-md-11">@ViewData["Title"]</h3>

                @if (await _accountService.AccountUserIsAuthorizedAsync("appointments.create"))
                {
                    <div class="col-md-1">
                        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i></a>
                    </div>
                }

            </div>

        </div>

        <div class="card-body mt-3">

            <form asp-action="Index" class="navbar-search" method="GET">

                <input type="hidden" name="Page" value="1" />

                <div class="row mt-3">

                    <div class="col-md-auto">
                        <select asp-for="RecordsPerPage" class="form-select bg-light border-0 small">
                            <option value="5" selected="@(Model.RecordsPerPage == 5)">5</option>
                            <option value="10" selected="@(Model.RecordsPerPage == 10)">10</option>
                            <option value="15" selected="@(Model.RecordsPerPage == 15)">15</option>
                            <option value="30" selected="@(Model.RecordsPerPage == 30)">30</option>
                            <option value="50" selected="@(Model.RecordsPerPage == 50)">50</option>
                        </select>
                    </div>

                    <div class="col-md-10">
                        <div class="input-group mb-3">
                            <input type="text"
                                   class="form-control bg-light border-0 small"
                                   placeholder="Buscar por paciente, doctor o servicio..."
                                   aria-label="search"
                                   asp-for="Filter" />

                            <button class="btn btn-primary"><i class="bi bi-search"></i></button>
                        </div>
                    </div>

                </div>

            </form>

            <table class="table table-bordered align-middle">

                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Paciente</th>
                        <th>Doctor</th>
                        <th>Servicio</th>
                        <th>Estado</th>
                        @if (canUpdate)
                        {
                            <th style="width: 200px;"></th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.List.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">No hay registros para mostrar.</td>
                        </tr>
                    }

                    @foreach (AppointmentDTO item in Model.List)
                    {
                        bool started = item.StartsAt <= DateTime.Now;

                        <tr>
                            <td>
                                @item.StartsAt.ToString("dd/MM/yyyy")<br />
                                <small class="text-muted">@item.StartsAt.ToString("HH:mm") - @item.EndsAt.ToString("HH:mm")</small>
                            </td>
                            <td>
                                @item.PatientName
                                @if (!string.IsNullOrWhiteSpace(item.Notes))
                                {
                                    <i class="bi bi-chat-left-text text-muted ms-1" title="@item.Notes"></i>
                                }
                            </td>
                            <td>@item.DoctorName</td>
                            <td>@item.ServiceName</td>
                            <td><span class="badge @item.Status.GetBadgeClass()">@item.Status.GetDisplayName()</span></td>
                            @if (canUpdate)
                            {
                                <td>
                                    @if (item.Status == AppointmentStatus.Scheduled)
                                    {
                                        if (started && !isPatient)
                                        {
                                            <form asp-action="ChangeStatus" method="POST" style="display: contents;">
                                                <input type="hidden" name="Id" value="@item.Id" />
                                                <input type="hidden" name="Status" value="@AppointmentStatus.Attended" />
                                                <button class="btn btn-sm btn-success btnStatus" title="Marcar como atendida" data-text="atendida">
                                                    <i class="bi bi-check2-circle"></i>
                                                </button>
                                            </form>

                                            <form asp-action="ChangeStatus" method="POST" style="display: contents;">
                                                <input type="hidden" name="Id" value="@item.Id" />
                                                <input type="hidden" name="Status" value="@AppointmentStatus.NoShow" />
                                                <button class="btn btn-sm btn-warning btnStatus" title="Marcar inasistencia" data-text="inasistida">
                                                    <i class="bi bi-person-x"></i>
                                                </button>
                                            </form>
                                        }

                                        <form asp-action="ChangeStatus" method="POST" style="display: contents;">
                                            <input type="hidden" name="Id" value="@item.Id" />
                                            <input type="hidden" name="Status" value="@AppointmentStatus.Cancelled" />
                                            <button class="btn btn-sm btn-secondary btnStatus" title="Cancelar cita" data-text="cancelada">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>

            </table>

            @await Html.PartialAsync("_PaginationComponent", Model)

        </div>
    </div>

</section>

@section Scripts {

    <script>

        $(document).ready(function() {

            $('.btnStatus').click(function(event) {

                event.preventDefault();

                Swal.fire({
                    icon: 'question',
                    title: '¿Marcar la cita como ' + $(this).data('text') + '?',
                    text: "Este cambio no se puede revertir.",
                    showCancelButton: true,
                    confirmButtonText: 'Sí, continuar',
                    cancelButtonText: 'Cancelar'

                }).then((result) => {

                    if (result.isConfirmed) {

                        const form = $(this).closest('form');
                        form.submit();
                    }
                });
            });
        });

    </script>

}
