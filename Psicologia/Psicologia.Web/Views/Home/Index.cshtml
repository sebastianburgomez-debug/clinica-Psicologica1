@inject IAccountService _accountService

@{
    ViewData["Title"] = "Inicio";
}

<div class="pagetitle">
    <h1>Panel de control</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item active">Inicio</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">
    <div class="row">

        @if (await _accountService.AccountUserIsAuthorizedAsync("specialties.show"))
        {
            <div class="col-xxl-4 col-md-6">
                <div class="card info-card sales-card">
                    <div class="card-body">
                        <h5 class="card-title">Especialidades</h5>

                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                <i class="bi bi-journal-medical"></i>
                            </div>
                            <div class="ps-3">
                                <a asp-controller="Specialties" asp-action="Index" class="btn btn-sm btn-primary">Administrar</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (await _accountService.AccountUserIsAuthorizedAsync("roles.show"))
        {
            <div class="col-xxl-4 col-md-6">
                <div class="card info-card revenue-card">
                    <div class="card-body">
                        <h5 class="card-title">Roles</h5>

                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                <i class="bi bi-person-badge"></i>
                            </div>
                            <div class="ps-3">
                                <a asp-controller="Roles" asp-action="Index" class="btn btn-sm btn-primary">Administrar</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (await _accountService.AccountUserIsAuthorizedAsync("users.show"))
        {
            <div class="col-xxl-4 col-md-6">
                <div class="card info-card customers-card">
                    <div class="card-body">
                        <h5 class="card-title">Usuarios</h5>

                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                <i class="bi bi-people"></i>
                            </div>
                            <div class="ps-3">
                                <a asp-controller="Users" asp-action="Index" class="btn btn-sm btn-primary">Administrar</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>
</section>
