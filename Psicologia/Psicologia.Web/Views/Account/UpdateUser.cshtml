@model AccountUserDTO

@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item active">Editar Mi Usuario</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">

    <div class="card">

        <div class="card-body">
            <h5 class="card-title text-primary">Editar mi Usuario</h5>

            <form asp-action="UpdateUser" method="POST" class="row g-3">

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="RoleName" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input value="@Model.Email" class="form-control" readonly />
                        <label asp-for="Email"></label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input value="@Model.RoleName" class="form-control" readonly />
                        <label asp-for="RoleName"></label>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-floating">
                        <input asp-for="Name" class="form-control" placeholder="@Html.DisplayNameFor(dto => dto.Name)" />
                        <label asp-for="Name"></label>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>

                <div class="text-center mt-3">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Volver</a>
                </div>
            </form>

        </div>

    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
