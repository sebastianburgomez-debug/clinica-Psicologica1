@model CreateDiagnosisDTO

@{
    ViewData["Title"] = "Nuevo Diagnóstico";
}

<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Historias Clínicas</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.ClinicalRecordId">@Model.PatientName</a></li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">

    <div class="card">

        <div class="card-header">

            <div class="row">

                <h3 class="m-0 font-weight-bold text-primary col-md-11">@ViewData["Title"]</h3>

            </div>

        </div>

        <div class="card-body">

            <form asp-action="AddDiagnosis" method="POST" class="row g-3 mt-2">

                <input type="hidden" asp-for="ClinicalRecordId" />
                <input type="hidden" asp-for="PatientName" />

                <div class="col-md-12">
                    <div class="form-floating">
                        <input value="@Model.PatientName" class="form-control" readonly />
                        <label asp-for="PatientName"></label>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-floating">
                        <input asp-for="Code" class="form-control" placeholder="@Html.DisplayNameFor(dto => dto.Code)" />
                        <label asp-for="Code"></label>
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-9">
                    <div class="form-floating">
                        <input asp-for="Name" class="form-control" placeholder="@Html.DisplayNameFor(dto => dto.Name)" />
                        <label asp-for="Name"></label>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<DiagnosisStatus>()" class="form-select"></select>
                        <label asp-for="Status"></label>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="DiagnosedAt" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" placeholder="@Html.DisplayNameFor(dto => dto.DiagnosedAt)" />
                        <label asp-for="DiagnosedAt"></label>
                        <span asp-validation-for="DiagnosedAt" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-floating">
                        <textarea asp-for="Observations" class="form-control" style="height: 140px" placeholder="@Html.DisplayNameFor(dto => dto.Observations)"></textarea>
                        <label asp-for="Observations"></label>
                        <span asp-validation-for="Observations" class="text-danger"></span>
                    </div>
                </div>

                <div class="text-center mt-3">
                    <button class="btn btn-primary" type="submit">Guardar</button>
                    <a asp-action="Details" asp-route-id="@Model.ClinicalRecordId" class="btn btn-secondary">Volver</a>
                </div>

            </form>

        </div>
    </div>

</section>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
