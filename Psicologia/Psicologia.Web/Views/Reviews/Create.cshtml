@model CreateReviewDTO
@{
    ViewData["Title"] = "Calificar Sesión";
}

<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-controller="PatientPortal" asp-action="Index">Mis Citas</a></li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">
    <div class="card">
        <div class="card-header">
            <div class="row">
                <h3 class="m-0 font-weight-bold text-primary col-md-11">@ViewData["Title"]</h3>
            </div>
        </div>
        <div class="card-body">
            <p class="mt-3 mb-0">
                <strong>@Model.ServiceName</strong> con <strong>@Model.DoctorName</strong><br />
                <span class="text-muted">Sesión del @Model.SessionDate.ToString("dd/MM/yyyy HH:mm")</span>
            </p>

            <form asp-action="Create" method="POST" class="row g-3 mt-2">
                <input type="hidden" asp-for="AppointmentId" />

                <div class="col-md-12">
                    <label class="form-label d-block">@Html.DisplayNameFor(dto => dto.Rating)</label>
                    @for (int i = 1; i <= 5; i++)
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="Rating" id="rating@(i)" value="@i" checked="@(Model.Rating == i)" />
                            <label class="form-check-label" for="rating@(i)">@i <i class="bi bi-star-fill text-warning"></i></label>
                        </div>
                    }
                    <span asp-validation-for="Rating" class="text-danger d-block"></span>
                </div>
                <div class="col-md-12">
                    <div class="form-floating">
                        <textarea asp-for="Comment" class="form-control" style="height: 120px" placeholder="@Html.DisplayNameFor(dto => dto.Comment)"></textarea>
                        <label asp-for="Comment"></label>
                        <span asp-validation-for="Comment" class="text-danger"></span>
                    </div>
                </div>
                <div class="text-center mt-3">
                    <button class="btn btn-primary" type="submit">Enviar calificación</button>
                    <a asp-controller="PatientPortal" asp-action="Index" class="btn btn-secondary">Volver</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
