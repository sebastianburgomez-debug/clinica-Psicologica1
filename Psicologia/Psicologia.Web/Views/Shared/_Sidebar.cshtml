@inject IAccountService _accountService

@{
    string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    string CssClass(string name) => controller.Equals(name, StringComparison.OrdinalIgnoreCase) ? "" : "collapsed";
}

<aside id="sidebar" class="sidebar">

    <ul class="sidebar-nav" id="sidebar-nav">

        <li class="nav-item">
            <a class="nav-link @CssClass("Home")" asp-controller="Home" asp-action="Index">
                <i class="bi bi-grid"></i>
                <span>Dashboard</span>
            </a>
        </li>

        @if (await _accountService.AccountUserIsAuthorizedAsync("specialties.show"))
        {
            <li class="nav-item">
                <a class="nav-link @CssClass("Specialties")" asp-controller="Specialties" asp-action="Index">
                    <i class="bi bi-journal-medical"></i>
                    <span>Especialidades</span>
                </a>
            </li>
        }

        @if (await _accountService.AccountUserIsAuthorizedAsync("users.show"))
        {
            <li class="nav-item">
                <a class="nav-link @CssClass("Users")" asp-controller="Users" asp-action="Index">
                    <i class="bi bi-people"></i>
                    <span>Usuarios</span>
                </a>
            </li>
        }

        @if (await _accountService.AccountUserIsAuthorizedAsync("roles.show"))
        {
            <li class="nav-item">
                <a class="nav-link @CssClass("Roles")" asp-controller="Roles" asp-action="Index">
                    <i class="bi bi-person-badge"></i>
                    <span>Roles</span>
                </a>
            </li>
        }

    </ul>

</aside>
