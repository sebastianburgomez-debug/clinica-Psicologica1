@model PaginationResponse<StaffDTO>
@inject IAccountService _accountService

@{
    ViewData["Title"] = "Personal";

    bool canUpdate = await _accountService.AccountUserIsAuthorizedAsync("staff.update");
    bool canToggle = await _accountService.AccountUserIsAuthorizedAsync("staff.toggle");
}

<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item">Administración del Sistema</li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">

    <div class="card">

        <div class="card-header">

            <div class="row">

                <h3 class="m-0 font-weight-bold text-primary col-md-11">Doctores y secretarias</h3>

                @if (await _accountService.AccountUserIsAuthorizedAsync("staff.create"))
                {
                    <div class="col-md-1">
                        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i></a>
                    </div>
                }

            </div>

        </div>

        <div class="card-body mt-3">

            <form asp-action="Index" class="navbar-search" method="GET">

                <input type="hidden" name="Page" value="1" />

                <div class="row mt-3">

                    <div class="col-md-auto">
                        <select asp-for="RecordsPerPage" class="form-select bg-light border-0 small">
                            <option value="5" selected="@(Model.RecordsPerPage == 5)">5</option>
                            <option value="10" selected="@(Model.RecordsPerPage == 10)">10</option>
                            <option value="15" selected="@(Model.RecordsPerPage == 15)">15</option>
                            <option value="30" selected="@(Model.RecordsPerPage == 30)">30</option>
                            <option value="50" selected="@(Model.RecordsPerPage == 50)">50</option>
                        </select>
                    </div>

                    <div class="col-md-10">
                        <div class="input-group mb-3">
                            <input type="text"
                                   class="form-control bg-light border-0 small"
                                   placeholder="Buscar por nombre, correo, rol o especialidad..."
                                   aria-label="search"
                                   asp-for="Filter" />

                            <button class="btn btn-primary"><i class="bi bi-search"></i></button>
                        </div>
                    </div>

                </div>

            </form>

            <table class="table table-bordered align-middle">

                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Especialidad</th>
                        <th>Aprobación</th>
                        <th>Estado</th>
                        <th style="width: 120px;"></th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.List.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">No hay registros para mostrar.</td>
                        </tr>
                    }

                    @foreach (StaffDTO item in Model.List)
                    {
                        bool isCurrentUser = item.Email == User.Identity?.Name;

                        <tr class="@(item.IsActive ? "" : "table-secondary")">
                            <td>@item.Name</td>
                            <td>@item.Email</td>
                            <td>@item.RoleName</td>
                            <td>
                                @item.SpecialtyName
                                @if (item.IsDoctor && item.ProfessionalLicense is not null)
                                {
                                    <small class="d-block text-muted">TP @item.ProfessionalLicense</small>
                                }
                            </td>
                            <td>
                                @if (item.DoctorStatus is not null)
                                {
                                    <span class="badge @item.DoctorStatus.Value.GetBadgeClass()">@item.DoctorStatus.Value.GetDisplayName()</span>
                                }
                                else if (item.IsDoctor)
                                {
                                    <span class="badge bg-light text-dark border">Sin perfil</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-primary">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td>
                                @if (canUpdate)
                                {
                                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.Id">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                }

                                @if (canToggle && !isCurrentUser)
                                {
                                    <form asp-action="Toggle" method="POST" style="display: contents;">
                                        <input type="hidden" name="UserId" value="@item.Id" />
                                        <input type="hidden" name="Deactivate" value="@(item.IsActive ? "true" : "false")" />

                                        <button class="btn btn-sm @(item.IsActive ? "btn-danger" : "btn-success") btnToggle"
                                                title="@(item.IsActive ? "Desactivar cuenta" : "Activar cuenta")"
                                                data-active="@(item.IsActive ? "true" : "false")">
                                            <i class="bi @(item.IsActive ? "bi-person-dash" : "bi-person-check")"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

            @await Html.PartialAsync("_PaginationComponent", Model)

        </div>
    </div>

</section>

@section Scripts {

    <script>

        $(document).ready(function() {

            $('.btnToggle').click(function(event) {

                event.preventDefault();

                const active = $(this).data('active') === true;

                Swal.fire({
                    icon: 'question',
                    title: active ? '¿Desea desactivar la cuenta?' : '¿Desea activar la cuenta?',
                    text: active ? 'El usuario no podrá iniciar sesión. Su información se conserva (borrado lógico).' : 'El usuario podrá volver a iniciar sesión.',
                    showCancelButton: true,
                    confirmButtonText: active ? 'Sí, desactivar' : 'Sí, activar',
                    cancelButtonText: 'Cancelar'

                }).then((result) => {

                    if (result.isConfirmed) {

                        const form = $(this).closest('form');
                        form.submit();
                    }
                });
            });
        });

    </script>

}
