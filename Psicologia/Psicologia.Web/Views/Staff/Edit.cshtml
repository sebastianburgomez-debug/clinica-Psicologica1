@model UpdateStaffDTO

@{
    ViewData["Title"] = "Editar Personal";

    bool isDoctor = Model.StaffType == StaffType.Doctor;
}

<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Personal</a></li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">

    <div class="card">

        <div class="card-header">

            <div class="row">

                <h3 class="m-0 font-weight-bold text-primary col-md-9">@ViewData["Title"]</h3>

                @if (isDoctor && Model.DoctorStatus is not null)
                {
                    <div class="col-md-3 text-md-end">
                        <span class="badge @Model.DoctorStatus.Value.GetBadgeClass()">@Model.DoctorStatus.Value.GetDisplayName()</span>
                    </div>
                }

            </div>

        </div>

        <div class="card-body">

            <form asp-action="Edit" method="POST" class="row g-3 mt-2">

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="StaffType" />

                <div class="col-md-6">
                    <div class="form-floating">
                        <input value="@Model.Email" class="form-control" readonly />
                        <label asp-for="Email"></label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input value="@Model.StaffType.GetDisplayName()" class="form-control" readonly />
                        <label asp-for="StaffType"></label>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-floating">
                        <input asp-for="Name" class="form-control" placeholder="@Html.DisplayNameFor(dto => dto.Name)" />
                        <label asp-for="Name"></label>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>

                @if (isDoctor)
                {
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select asp-for="SpecialtyId" asp-items="Model.Specialties" class="form-select">
                                <option value="">-- Seleccione una especialidad --</option>
                            </select>
                            <label asp-for="SpecialtyId"></label>
                            <span asp-validation-for="SpecialtyId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="ProfessionalLicense" class="form-control" placeholder="@Html.DisplayNameFor(dto => dto.ProfessionalLicense)" />
                            <label asp-for="ProfessionalLicense"></label>
                            <span asp-validation-for="ProfessionalLicense" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="form-floating">
                            <textarea asp-for="Biography" class="form-control" style="height: 100px" placeholder="@Html.DisplayNameFor(dto => dto.Biography)"></textarea>
                            <label asp-for="Biography"></label>
                            <span asp-validation-for="Biography" class="text-danger"></span>
                        </div>
                    </div>
                }

                <div class="text-center mt-3">
                    <button class="btn btn-primary" type="submit">Guardar</button>
                    <a asp-action="Index" class="btn btn-secondary">Volver</a>
                </div>

            </form>

        </div>
    </div>

</section>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
