@model UpdateRoleDTO

@{
    ViewData["Title"] = "Editar Rol";
}

<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Roles</a></li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">

    <div class="card">

        <div class="card-header">

            <div class="row">

                <h3 class="m-0 font-weight-bold text-primary col-md-11">@ViewData["Title"]</h3>

            </div>

        </div>

        <div class="card-body">

            <form asp-action="Edit" method="POST" class="row g-3 mt-2" id="frmRole">

                <input type="hidden" asp-for="Id" />
                <input type="hidden" id="permissionIds" asp-for="PermissionIds" />

                <div class="col-md-12">
                    <div class="form-floating">
                        <input asp-for="Name" class="form-control" placeholder="@Html.DisplayNameFor(dto => dto.Name)" />
                        <label asp-for="Name"></label>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>

            </form>

        </div>
    </div>

    @await Html.PartialAsync("_Permissions", Model.Permissions ?? new List<PermissionsForRoleDTO>())

    <div class="text-center mt-3">
        <button class="btn btn-primary" type="submit" form="frmRole" id="btnSaveRole">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>

</section>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        await Html.RenderPartialAsync("_PermissionsScript");
    }
}
