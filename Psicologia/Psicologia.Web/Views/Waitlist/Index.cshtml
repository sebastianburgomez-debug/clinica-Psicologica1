@model PaginationResponse<WaitlistEntryDTO>
@inject IAccountService _accountService
@{
    ViewData["Title"] = "Lista de Espera";
    bool canManage = await _accountService.AccountUserIsAuthorizedAsync("waitlist.manage");
}

<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item">Atención Clínica</li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">
    <div class="card">
        <div class="card-header">
            <div class="row">
                <h3 class="m-0 font-weight-bold text-primary col-md-11">@ViewData["Title"]</h3>
                @if (canManage)
                {
                    <div class="col-md-1">
                        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i></a>
                    </div>
                }
            </div>
        </div>
        <div class="card-body mt-3">
            <form asp-action="Index" class="navbar-search" method="GET">
                <input type="hidden" name="Page" value="1" />
                <div class="row mt-3">
                    <div class="col-md-auto">
                        <select asp-for="RecordsPerPage" class="form-select bg-light border-0 small">
                            <option value="5" selected="@(Model.RecordsPerPage == 5)">5</option>
                            <option value="10" selected="@(Model.RecordsPerPage == 10)">10</option>
                            <option value="15" selected="@(Model.RecordsPerPage == 15)">15</option>
                            <option value="30" selected="@(Model.RecordsPerPage == 30)">30</option>
                            <option value="50" selected="@(Model.RecordsPerPage == 50)">50</option>
                        </select>
                    </div>
                    <div class="col-md-10">
                        <div class="input-group mb-3">
                            <input type="text"
                                   class="form-control bg-light border-0 small"
                                   placeholder="Buscar por paciente o servicio..."
                                   aria-label="search"
                                   asp-for="Filter" />
                            <button class="btn btn-primary"><i class="bi bi-search"></i></button>
                        </div>
                    </div>
                </div>
            </form>

            <table class="table table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Registrado</th>
                        <th>Paciente</th>
                        <th>Servicio</th>
                        <th>Preferencia</th>
                        <th>Estado</th>
                        @if (canManage)
                        {
                            <th style="width: 120px;"></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.List.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">No hay registros para mostrar.</td>
                        </tr>
                    }

                    @foreach (WaitlistEntryDTO item in Model.List)
                    {
                        <tr>
                            <td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @item.PatientName
                                @if (!string.IsNullOrWhiteSpace(item.Notes))
                                {
                                    <i class="bi bi-chat-left-text text-muted ms-1" title="@item.Notes"></i>
                                }
                            </td>
                            <td>@item.ServiceName</td>
                            <td>
                                @(item.DoctorName ?? "Cualquier doctor")<br />
                                <small class="text-muted">@(item.PreferredDate?.ToString("dd/MM/yyyy") ?? "Cualquier fecha")</small>
                            </td>
                            <td><span class="badge @item.Status.GetBadgeClass()">@item.Status.GetDisplayName()</span></td>
                            @if (canManage)
                            {
                                <td>
                                    @if (item.Status == WaitlistStatus.Waiting)
                                    {
                                        <a asp-action="Assign" asp-route-id="@item.Id" class="btn btn-sm btn-success" title="Asignar cupo">
                                            <i class="bi bi-calendar-plus"></i>
                                        </a>
                                        <form asp-action="Cancel" method="POST" style="display: contents;">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button class="btn btn-sm btn-secondary btnCancel" title="Cancelar registro">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>

            @await Html.PartialAsync("_PaginationComponent", Model)
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.btnCancel').click(function(event) {
                event.preventDefault();
                Swal.fire({
                    icon: 'question',
                    title: '¿Cancelar el registro de la lista de espera?',
                    text: "Este cambio no se puede revertir.",
                    showCancelButton: true,
                    confirmButtonText: 'Sí, cancelar',
                    cancelButtonText: 'Volver'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $(this).closest('form').submit();
                    }
                });
            });
        });
    </script>
}
